<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- studio.marketing.worker
     Thợ chạy hàng việc của chiến dịch. KHÔNG nạp mặc định (F13).

     MẪU — mọi `__TÊN__` là chỗ trống. Đừng sửa tay bản trong `~/Library/LaunchAgents`:
     sửa ở đây rồi chạy lại `scripts/runners/install_launchd.py`.
     `__CHANNEL__` / `__CAMPAIGN__` lấy từ cờ `map` của bộ cài lịch, hoặc từ
     `<trạm>/launchd.json`. Xem `docs/RUNBOOK-DOI-MAY.md`.

     (Chú thích XML không chứa được hai dấu gạch liền nhau, nên tên cờ ở đây
      viết trần. Chạy bộ cài lịch với cờ trợ giúp để thấy tên đầy đủ.) -->
<plist version="1.0">
<dict>
  <key>Label</key><string>studio.marketing.worker</string>

  <key>ProgramArguments</key>
  <array>
    <string>pwsh</string>
    <string>-NoProfile</string>
    <string>-File</string>
    <string>__REPO__/scripts/runners/run-worker.ps1</string>
    <string>-Campaign</string>
    <string>__STATION__/__CHANNEL__/__CAMPAIGN__</string>
  </array>

    <!-- PATH: launchd KHÔNG đọc ~/.zshrc. Job chỉ thấy PATH khai ở đây, nên
         `ffmpeg`, `pwsh`, `node`, `npx` phải nằm trong danh sách này. Đầu log của
         notify_run.py in `which` của từng cái — đọc là biết thiếu gì.
         OMNIVOICE_DEVICE / OMNIVOICE_DTYPE: Apple Silicon chạy `mps` + `float16`.
         HF_DEACTIVATE_ASYNC_LOAD=1: bắt buộc khi nạp trọng số trên MPS. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>PYTHONUTF8</key><string>1</string>
    <key>MARKETING_STUDIO_DATA</key><string>__STATION__</string>
    <key>MARKETING_STUDIO_HOME</key><string>__REPO__</string>
    <key>MARKETING_STUDIO_PY</key><string>__PY__</string>
    <key>VOICE_STATION</key><string>__VOICE_STATION__</string>
    <key>VIDEO_STATION</key><string>__VIDEO_STATION__</string>
    <key>OMNIVOICE_PY</key><string>__OMNIVOICE_PY__</string>
    <key>OMNIVOICE_DEVICE</key><string>mps</string>
    <key>OMNIVOICE_DTYPE</key><string>float16</string>
    <key>HF_DEACTIVATE_ASYNC_LOAD</key><string>1</string>
  </dict>

  <key>WorkingDirectory</key><string>__STATION__</string>
  <key>StandardOutPath</key><string>__STATION__/logs/launchd/studio.marketing.worker.out.log</string>
  <key>StandardErrorPath</key><string>__STATION__/logs/launchd/studio.marketing.worker.err.log</string>
  <key>ProcessType</key><string>Background</string>
  <!-- Không bọc notify_run và không đặt trần giờ: thợ làm MỘT việc rồi
       thoát, và lượt rỗng thì im lặng. Trần của nó là chính vòng đời một việc.
       Xem đầu `run-worker.ps1`. -->
  <!-- Task Scheduler bản Windows gọi lại mỗi phút và để MultipleInstances
       = IgnoreNew từ chối 54/55 lượt. launchd đã bảo đảm MỘT bản chạy trên mỗi
       Label, nên bản dịch đúng là KeepAlive + ThrottleInterval: chết thì dựng lại,
       không bao giờ có hai bản. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
</dict>
</plist>

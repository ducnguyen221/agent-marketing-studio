<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- studio.marketing.daily-news-b
     Lượt tin hằng ngày, khung 2 (bản Windows: 19:00, DaysInterval = 2).

     ⚠️ launchd KHÔNG dịch được "cách ngày". `StartCalendarInterval` là lịch
     theo NGÀY GIỜ (giờ/phút/thứ/ngày trong tháng), không có "mỗi N ngày"; còn
     `StartInterval` (172800 giây) thì đếm từ lúc nạp job, nên nó trôi mỗi lần
     khởi động lại máy và bắn ngay khi nạp. Bản dịch chọn ở đây: chạy MỖI NGÀY
     đúng giờ, và để chính lượt chạy quyết định có làm hay không (bỏ qua =
     thoát mã 0). Trước khi bật job này hãy kiểm lượt chạy có tự bỏ ngày lẻ
     không — nếu không thì nó sẽ chạy gấp đôi số lần so với bản Windows.

     MẪU — mọi `__TÊN__` là chỗ trống. Đừng sửa tay bản trong `~/Library/LaunchAgents`:
     sửa ở đây rồi chạy lại `scripts/runners/install_launchd.py`.
     `__CHANNEL__` / `__CAMPAIGN__` lấy từ cờ `map` của bộ cài lịch, hoặc từ
     `<trạm>/launchd.json`. Xem `docs/RUNBOOK-DOI-MAY.md`.

     (Chú thích XML không chứa được hai dấu gạch liền nhau, nên tên cờ ở đây
      viết trần. Chạy bộ cài lịch với cờ trợ giúp để thấy tên đầy đủ.) -->
<plist version="1.0">
<dict>
  <key>Label</key><string>studio.marketing.daily-news-b</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>__REPO__/scripts/runners/notify_run.py</string>
    <string>--title</string>
    <string>__CHANNEL__ · __CAMPAIGN__</string>
    <string>--composer-dir</string>
    <string>__REPO__/scripts/runners</string>
    <string>--timeout</string>
    <string>7200</string>
    <string>--</string>
    <string>pwsh</string>
    <string>-NoProfile</string>
    <string>-File</string>
    <string>__STATION__/__CHANNEL__/__CAMPAIGN__/__RUNNER__</string>
  </array>

    <!-- PATH: launchd KHÔNG đọc ~/.zshrc. Job chỉ thấy PATH khai ở đây, nên
         `ffmpeg`, `pwsh`, `node`, `npx`, `claude` phải nằm trong danh sách này
         (`~/.local/bin` là chỗ bộ cài Claude Code và pipx đặt lệnh; bộ cài lịch mở
         rộng `~` thành đường nhà thật vì launchd không tự mở rộng). Đầu log của
         notify_run.py in `which` của từng cái — đọc là biết thiếu gì.
         OMNIVOICE_DEVICE=mps: ép dùng GPU tích hợp của Apple Silicon.
         OMNIVOICE_DTYPE=float32 — ĐÂY LÀ PIPELINE TIN, KHÔNG PHẢI TRUYỆN. Một lượt tin
         chỉ 4–12 phút (bản tuần ~41 phút) trong cửa sổ 18:00–21:00, nên nó thừa thời
         gian để đổi tốc độ lấy độ chính xác. Và vì không đi nhánh fp16 nên ở đây KHÔNG
         khai HF_DEACTIVATE_ASYNC_LOAD: biến đó vá một vụ nổ chỉ xảy ra lúc nạp trọng số
         fp16 trên MPS, khai thừa chỉ làm người sau tưởng hai pipeline giống nhau.
         Cấu hình của TRUYỆN nằm ở `studio.marketing.daily-story` và khác hẳn — xem
         `docs/RUNBOOK-DOI-MAY.md` mục "hai pipeline, hai cấu hình". -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>PYTHONUTF8</key><string>1</string>
    <key>MARKETING_STUDIO_DATA</key><string>__STATION__</string>
    <key>MARKETING_STUDIO_HOME</key><string>__REPO__</string>
    <key>MARKETING_STUDIO_PY</key><string>__PY__</string>
    <key>VOICE_STATION</key><string>__VOICE_STATION__</string>
    <key>VIDEO_STATION</key><string>__VIDEO_STATION__</string>
    <key>OMNIVOICE_PY</key><string>__OMNIVOICE_PY__</string>
    <key>OMNIVOICE_DEVICE</key><string>mps</string>
    <key>OMNIVOICE_DTYPE</key><string>float32</string>
    <!-- CON TRỎ bí mật: TÊN khai ở đây, GIÁ TRỊ bộ cài lịch điền từ biến môi trường
         hoặc từ file .env của repo (chế độ embedded). Giá trị là ĐƯỜNG DẪN tới file
         bí mật, không bao giờ là bí mật. Biến chưa khai ở đâu thì bộ cài BỎ cả dòng
         (không ghi chuỗi rỗng) và in tên nó ra. Tên thêm theo kênh (hậu tố tài
         khoản) khai ở khoá env của launchd.json, chèn vào chỗ đánh dấu ngay dưới. -->
    <key>TG_CONFIG</key><string>__ENV_TG_CONFIG__</string>
    <key>TG_CHAT</key><string>__ENV_TG_CHAT__</string>
    <key>YT_CLIENT_SECRET</key><string>__ENV_YT_CLIENT_SECRET__</string>
    <key>YT_TOKEN_PATH</key><string>__ENV_YT_TOKEN_PATH__</string>
    <key>FB_CONFIG</key><string>__ENV_FB_CONFIG__</string>
    <key>EMAIL_CONFIG</key><string>__ENV_EMAIL_CONFIG__</string>
    <key>CODEX_BRIDGE</key><string>__ENV_CODEX_BRIDGE__</string>
    <!-- __ENV_EXTRA__ -->
  </dict>

  <key>WorkingDirectory</key><string>__STATION__</string>
  <key>StandardOutPath</key><string>__STATION__/logs/launchd/studio.marketing.daily-news-b.out.log</string>
  <key>StandardErrorPath</key><string>__STATION__/logs/launchd/studio.marketing.daily-news-b.err.log</string>
  <!-- ProcessType=Interactive: job NẶNG (TTS + dựng video). `Background` làm macOS hãm CPU
       + I/O và dồn sang nhân tiết kiệm — P0-10 (Mac mini 01/10/2026): dựng 10 chương mất
       5 h 16 thay vì ~40 phút, tải trung bình 2,1 suốt 7 h, 0 cảnh báo nhiệt. Worker và
       poller (nhẹ, chạy liên tục) giữ Background. Cổng: tests/test_launchd_templates.py. -->
  <key>ProcessType</key><string>Interactive</string>
  <key>RunAtLoad</key><false/>
  <key>StartCalendarInterval</key>
  <dict>
      <key>Hour</key><integer>19</integer>
      <key>Minute</key><integer>0</integer>
  </dict>
</dict>
</plist>

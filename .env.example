# Sao chép thành `.env` rồi điền. `.env` đã bị gitignore — KHÔNG commit.
#
# CÁCH NỐI: `channel.yml` của mỗi kênh khai TÊN BIẾN (`secrets_env`), file này giữ GIÁ TRỊ.
# Không bao giờ ngược lại — `channel.yml` nằm trong trạm và có thể bị chia sẻ, `.env` thì không.
#
#   channel.yml:   secrets_env: { token: YT_TOKEN_PATH, client: YT_CLIENT_SECRET }
#   .env      :   YT_TOKEN_PATH=D:\duong\dan\youtube_token.json
#
# Chú ý chữ `PATH`: biến này giữ ĐƯỜNG DẪN tới file JSON, không giữ nội dung. Thư viện
# Google ghi đè file token tại chỗ mỗi lần làm mới, nên nó phải là file thật — và nhờ vậy
# bạn mở ra đọc được khi cần lấy tay.

# ── YouTube (Data API v3 + Analytics API) ───────────────────────────────────
# Scope cần: https://www.googleapis.com/auth/youtube
#            https://www.googleapis.com/auth/yt-analytics.readonly   ← để đọc số liệu
YT_CLIENT_SECRET=
YT_TOKEN_PATH=

# ── Facebook Page (Graph API) ───────────────────────────────────────────────
# Page token cần quyền: pages_manage_posts, pages_read_engagement,
#                       pages_manage_engagement  ← THIẾU cái này là không đăng được comment,
#                       read_insights                và bài không comment là bài mồ côi.
FB_CONFIG=

# ── Thông báo (tuỳ chọn) ────────────────────────────────────────────────────
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── NHIỀU KÊNH TRÊN CÙNG MỘT MÁY ────────────────────────────────────────────
# Mỗi kênh một tài khoản khác nhau thì đặt tên biến khác nhau, và khai đúng tên đó trong
# `channel.yml` của từng kênh. Hậu tố là tuỳ bạn — **không có script nào áp đặt sơ đồ tên**;
# thứ duy nhất phải khớp là: tên trong `channel.yml` == tên ở đây.
#
#   <kênh A>/channel.yml:  secrets_env: { token: YT_TOKEN_PATH_A, config: FB_CONFIG_A }
#   <kênh B>/channel.yml:  secrets_env: { token: YT_TOKEN_PATH_B, config: FB_CONFIG_B }
#
# YT_TOKEN_PATH_A=
# YT_CLIENT_SECRET_A=
# FB_CONFIG_A=
#
# YT_TOKEN_PATH_B=
# YT_CLIENT_SECRET_B=
# FB_CONFIG_B=

# Quy trình lấy token + scope: knowledge/toolchains/PLATFORM_SETUP.md

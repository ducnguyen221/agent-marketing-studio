# ── Instance data: chỉ KPIM (bộ mẫu khoá học) được lên GitHub ──────────────
content/*
!content/.gitkeep
!content/KPIM/



# ── Chế độ cài `embedded` (F17): trạm + lựa chọn cài nằm TRONG repo ──────────
# Cổng canh từng dòng: tests/test_gitignore_guard.py. Xoá một dòng ở đây là im lặng
# mở cửa cho nội dung riêng đi lên một repo công khai; hook pre-commit
# (templates/hooks/pre-commit) là lớp rào thứ hai, `doctor.py` đo lại cả hai.
/workspace/
studio.local.json

# ── Secret: không bao giờ ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*token*.json
*client_secret*.json
*credentials*.json
instances.json

# ── Python / OS ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
Thumbs.db
.DS_Store
desktop.ini
~$*
.~lock.*

# ── Thứ công cụ tự sinh (Claude Code, linter, coverage, IDE) ────────────────
# Cổng canh từng dòng: tests/test_gitignore_guard.py (DONG_CONG_CU).
.claude/settings.local.json
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/
*.log

# Plan/thiet ke noi bo -> luu o kho ho so RIENG ngoai repo nay (PRIVATE).
# Ly do: plan chua duong dan may + ten to chuc; repo nay public va docs/ duoc GitHub Pages phat ra web.
docs/plans/

# Vung nhap/trung gian cua agent — KHONG bao gio commit.
.tmp/

# Bài mẫu offline (samples/): chạy tay `blog_gates.py samples/bai-mau` ghi nhật ký cổng vào
# thư mục bài. Kết quả KỲ VỌNG cố định là `samples/gates-expected.json`, không phải file này.
samples/**/gates.json

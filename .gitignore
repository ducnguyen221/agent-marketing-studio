# ── Instance data: chỉ KPIM (bộ mẫu khoá học) được lên GitHub ──────────────
content/*
!content/.gitkeep
!content/KPIM/



# ── Chế độ cài `embedded` (F17): trạm + lựa chọn cài nằm TRONG repo ──────────
# Cổng canh từng dòng: tests/test_gitignore_guard.py. Xoá một dòng ở đây là im lặng
# mở cửa cho nội dung riêng đi lên một repo công khai; hook pre-commit
# (templates/hooks/pre-commit) là lớp rào thứ hai, `doctor.py` đo lại cả hai.
/workspace/
studio.local.json

# ── Secret: không bao giờ ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*token*.json
*client_secret*.json
*credentials*.json
instances.json

# ── Python / OS ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
Thumbs.db
desktop.ini
~$*
.~lock.*

# Plan/thiet ke noi bo -> luu tap trung o ~/.opcos/repo/<repo>/plans/ (repo opc-os, PRIVATE).
# Ly do: plan chua duong dan may + ten to chuc; repo nay public va docs/ duoc GitHub Pages phat ra web.
docs/plans/

# Vung nhap/trung gian cua agent — KHONG bao gio commit.
.tmp/
